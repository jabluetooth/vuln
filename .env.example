# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Your Gemini API key — get it free from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Your GitHub repo in the format: username/repo-name
REPO_NAME=your-username/your-repo

# Minimum severity to create a patch PR (LOW, MODERATE, HIGH, CRITICAL)
MIN_SEVERITY=HIGH
